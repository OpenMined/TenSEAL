# The sdist must carry everything CMake needs to build the extension from
# source. README.md, LICENSE, pyproject.toml and setup.py are added by
# setuptools automatically.
include CMakeLists.txt
recursive-include cmake *.cmake
recursive-include tenseal *.cpp *.h *.proto

# Generated by protoc during the build; never ship a stale copy.
recursive-exclude tenseal *.pb.cc *.pb.h
